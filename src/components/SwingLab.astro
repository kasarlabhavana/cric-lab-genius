---
---
<div class="swing" data-swing-lab>
  <div class="viz">
    <svg viewBox="0 0 400 340" role="img" aria-labelledby="swing-desc" class="ball-view">
      <title id="swing-desc">Top-down view of the ball with airflow on each side</title>
      <defs>
        <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="var(--track)" /></marker>
        <marker id="arrF" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="var(--ink)" /></marker>
      </defs>
      <g stroke="var(--ink-3)" stroke-width="1.2" opacity="0.6">
        <line x1="120" y1="10" x2="120" y2="70" marker-end="url(#arr)" />
        <line x1="200" y1="10" x2="200" y2="70" marker-end="url(#arr)" />
        <line x1="280" y1="10" x2="280" y2="70" marker-end="url(#arr)" />
      </g>
      <text x="296" y="44" font-size="13" fill="var(--ink-3)" font-family="var(--sans)">airflow</text>
      <path data-wake fill="var(--outfield-soft)" stroke="none" />
      <circle cx="200" cy="160" r="60" fill="var(--leather)" />
      <g data-seam-g>
        <line x1="200" y1="96" x2="200" y2="224" stroke="var(--bg)" stroke-width="3" />
        <line x1="194" y1="96" x2="194" y2="224" stroke="var(--bg)" stroke-width="1.4" stroke-dasharray="3 3" />
        <line x1="206" y1="96" x2="206" y2="224" stroke="var(--bg)" stroke-width="1.4" stroke-dasharray="3 3" />
      </g>
      <path data-bl-left fill="none" stroke="var(--track)" stroke-width="3" />
      <path data-bl-right fill="none" stroke="var(--track)" stroke-width="3" />
      <line data-force x1="200" y1="160" x2="200" y2="160" stroke="var(--ink)" stroke-width="4" marker-end="url(#arrF)" />
      <text data-force-label x="200" y="146" font-size="13" fill="var(--ink)" font-family="var(--sans)" text-anchor="middle">push</text>
      <text data-lab-left x="40" y="300" font-size="14" fill="var(--ink-2)" font-family="var(--sans)">laminar</text>
      <text data-lab-right x="360" y="300" font-size="14" fill="var(--ink-2)" font-family="var(--sans)" text-anchor="end">turbulent</text>
    </svg>
    <svg viewBox="0 0 200 340" class="path-view" role="img" aria-label="Illustrative path of the ball from release (bottom) to batter (top)">
      <rect x="70" y="10" width="60" height="320" fill="var(--clay)" rx="3" />
      <g stroke="var(--ink)" stroke-width="2"><line x1="92" y1="14" x2="108" y2="14" /><line x1="92" y1="326" x2="108" y2="326" /></g>
      <path data-flight fill="none" stroke="var(--track)" stroke-width="3" />
      <text x="100" y="338" font-size="11" text-anchor="middle" fill="var(--ink-3)" font-family="var(--sans)">release</text>
    </svg>
  </div>

  <div class="panel-out" aria-live="polite">
    <p class="regime" data-regime>Conventional swing</p>
    <p class="explain" data-explain></p>
  </div>

  <div class="controls">
    <div class="control">
      <span>Ball condition</span>
      <div class="seg" role="group" aria-label="Ball condition">
        <button type="button" aria-pressed="true" data-cond="new">New</button>
        <button type="button" aria-pressed="false" data-cond="middle">Middle-aged</button>
        <button type="button" aria-pressed="false" data-cond="old">Old, one side rough</button>
      </div>
    </div>
    <label class="control">Speed <output class="num" data-o="speed">130 km/h</output>
      <input type="range" min="60" max="160" value="130" data-i="speed" />
    </label>
    <label class="control">Seam angle <output class="num" data-o="angle">20°</output>
      <input type="range" min="0" max="35" value="20" data-i="angle" />
    </label>
  </div>
  <p class="note muted">Illustrative model. The speed thresholds are rounded from wind-tunnel ranges (new ball reversing only at very high speed; a roughened ball reversing from roughly 110 km/h). Real values vary with the ball, its wear and the seam's position at release. Swing strength is shown qualitatively, not in centimetres.</p>
</div>

<style>
  .swing { display: grid; gap: 20px; }
  .viz { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; align-items: center; }
  .ball-view, .path-view { width: 100%; height: auto; }
  .regime { font-weight: 800; font-variation-settings: "wdth" 120; font-size: var(--s3); margin: 0; }
  .explain { font-family: var(--serif); font-size: 1.1rem; color: var(--ink-2); margin: 8px 0 0; max-width: 36em; }
  .controls { display: grid; gap: 18px; }
  @media (min-width: 720px) { .controls { grid-template-columns: 1.4fr 1fr 1fr; } }
  .control > span { font-weight: 600; font-size: var(--s-1); display: block; margin-bottom: 6px; }
  .seg { flex-wrap: wrap; }
  .note { font-size: var(--s-1); margin: 0; max-width: 46em; }
</style>

<script>
  import { swing } from "../scripts/physics";

  document.querySelectorAll<HTMLElement>("[data-swing-lab]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const speed = $<HTMLInputElement>('[data-i="speed"]');
    const angle = $<HTMLInputElement>('[data-i="angle"]');
    let cond: "new" | "middle" | "old" = "new";
    const cx = 200, cy = 160, r = 60;
    const rad = (d: number) => (d * Math.PI) / 180;
    // point on circle at angle theta from the front (top), side = -1 left, +1 right
    const pt = (theta: number, side: number, rr = r + 5) => [cx + side * rr * Math.sin(rad(theta)), cy - rr * Math.cos(rad(theta))];

    function layer(side: number, sep: number, turbulent: boolean) {
      let d = "";
      for (let t = 0; t <= sep; t += 3) {
        const wob = turbulent ? Math.sin(t / 4) * 2.2 : 0;
        const [x, y] = pt(t, side, r + 5 + wob);
        d += (t === 0 ? "M" : "L") + x.toFixed(1) + " " + y.toFixed(1);
      }
      const [ex, ey] = pt(sep, side);
      // leave the surface tangentially-ish, downstream
      const dx = side * (turbulent ? -10 : 18), dy = 80;
      d += ` Q ${(ex + dx / 2).toFixed(1)} ${(ey + dy / 2).toFixed(1)} ${(ex + dx).toFixed(1)} ${(ey + dy).toFixed(1)}`;
      return { d, end: [ex + dx, ey + dy] };
    }

    function update() {
      const s = Number(speed.value), a = Number(angle.value);
      $('[data-o="speed"]').textContent = `${s} km/h`;
      $('[data-o="angle"]').textContent = `${a}°`;
      const res = swing(s, a, cond);
      // Seam points right (towards the slips for a right-arm outswinger viewed from behind).
      const right = res.seamSide === "turbulent", left = res.otherSide === "turbulent";
      // In reverse swing the seam thickens its (turbulent) layer, so it separates earlier than the other side.
      const sepR = res.regime === "reverse" ? 100 : right ? 118 : 86;
      const sepL = left ? 118 : 86;
      const L = layer(-1, sepL, left), R = layer(1, sepR, right);
      $<SVGPathElement>("[data-bl-left]").setAttribute("d", L.d);
      $<SVGPathElement>("[data-bl-right]").setAttribute("d", R.d);
      const [lx, ly] = pt(sepL, -1, r), [rx2, ry2] = pt(sepR, 1, r);
      $<SVGPathElement>("[data-wake]").setAttribute("d", `M${lx} ${ly} L${L.end[0]} ${L.end[1] + 40} L${R.end[0]} ${R.end[1] + 40} L${rx2} ${ry2} A ${r} ${r} 0 0 1 ${lx} ${ly} Z`);
      $<SVGGElement>("[data-seam-g]").setAttribute("transform", `rotate(${a} ${cx} ${cy})`);
      $<SVGTextElement>("[data-lab-left]").textContent = left ? "turbulent" : "laminar";
      $<SVGTextElement>("[data-lab-right]").textContent = right ? "turbulent (seam side)" : "laminar (seam side)";

      const dir = res.regime === "conventional" ? 1 : res.regime === "reverse" ? -1 : 0;
      const len = 70 * res.strength;
      const f = $<SVGLineElement>("[data-force]");
      const startX = cx + dir * (r + 14);
      f.setAttribute("x1", String(startX));
      f.setAttribute("x2", String(startX + dir * Math.max(len, 12)));
      f.style.opacity = dir ? "1" : "0";
      const fl = $<SVGTextElement>("[data-force-label]");
      fl.setAttribute("x", String(startX + dir * (Math.max(len, 12) / 2)));
      fl.setAttribute("y", "140");
      fl.style.opacity = dir ? "1" : "0";

      // Path: release at bottom, batter at top; deviation grows late (quadratic).
      let d = "";
      for (let i = 0; i <= 20; i++) {
        const f = i / 20;
        const x = 100 + dir * res.strength * 26 * f * f;
        const y = 326 - f * 312;
        d += (i ? "L" : "M") + x.toFixed(1) + " " + y.toFixed(1);
      }
      $<SVGPathElement>("[data-flight]").setAttribute("d", d);

      const word = { none: "Little or no swing", conventional: "Conventional swing", reverse: "Reverse swing" }[res.regime];
      $("[data-regime]").textContent = word;
      const ex = {
        none: a < 5
          ? "With the seam almost straight, neither side is tripped differently, so the airflow is roughly symmetrical."
          : "Both sides are behaving alike, so there is little pressure difference to push the ball sideways.",
        conventional: "The seam trips its side into turbulence, which clings to the ball longer. The smooth side separates early, so the ball is pushed towards the side the seam points.",
        reverse: "Both sides are now turbulent. The seam thickens the layer on its side so it separates first, and the push flips: the ball moves away from where the seam points.",
      }[res.regime];
      $("[data-explain]").textContent = ex;
    }

    root.querySelectorAll<HTMLButtonElement>("[data-cond]").forEach((b) =>
      b.addEventListener("click", () => {
        cond = b.dataset.cond as typeof cond;
        root.querySelectorAll("[data-cond]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        update();
      }),
    );
    [speed, angle].forEach((i) => i.addEventListener("input", update));
    update();
  });
</script>
