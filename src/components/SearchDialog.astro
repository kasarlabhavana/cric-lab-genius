---
---
<dialog class="search" id="search-dialog" aria-label="Search CricScience">
  <form method="dialog" class="search-form" role="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <label class="sr-only" for="search-input">Search lessons, labs and glossary</label>
    <input id="search-input" type="search" placeholder="Search lessons, labs and terms" autocomplete="off" />
    <button type="submit" class="close" aria-label="Close search">Esc</button>
  </form>
  <ul class="results" id="search-results" role="list"></ul>
  <p class="hint muted" id="search-hint">Try “reverse swing”, “sweet spot” or “umpire's call”.</p>
</dialog>

<style>
  .search { width: min(640px, calc(100vw - 32px)); max-height: min(70vh, 640px); padding: 0; border: 1px solid var(--rule); border-radius: 10px; background: var(--raised); color: var(--ink); margin-top: 10vh; }
  .search::backdrop { background: rgb(10 20 15 / 0.45); }
  .search-form { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--rule); color: var(--ink-3); }
  .search-form input { flex: 1; border: 0; background: none; font: inherit; font-size: 1.1rem; color: var(--ink); outline: none; min-width: 0; }
  .close { border: 1px solid var(--rule); background: none; border-radius: 4px; font-size: 0.75rem; padding: 2px 6px; cursor: pointer; color: var(--ink-3); }
  .results { list-style: none; margin: 0; padding: 6px; overflow-y: auto; max-height: calc(min(70vh, 640px) - 64px); }
  .results :global(a) { display: block; padding: 10px 12px; border-radius: 6px; text-decoration: none; color: var(--ink); }
  .results :global(a:hover), .results :global(a:focus-visible) { background: var(--outfield-soft); outline: none; }
  .results :global(.kind) { font-size: 0.8rem; color: var(--ink-3); }
  .results :global(.t) { font-weight: 650; }
  .results :global(.s) { font-family: var(--serif); color: var(--ink-2); font-size: 0.95rem; }
  .hint { padding: 0 18px 14px; margin: 0; font-size: 0.9rem; }
</style>

<script>
  import { asset, page } from "../scripts/paths";
  type Item = { kind: string; title: string; text: string; url: string };
  const dialog = document.getElementById("search-dialog") as HTMLDialogElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const list = document.getElementById("search-results") as HTMLUListElement;
  const hint = document.getElementById("search-hint") as HTMLParagraphElement;
  let index: Item[] | null = null;

  async function ensureIndex() {
    if (index) return index;
    try {
      const res = await fetch(asset("/search.json"));
      index = (await res.json()) as Item[];
    } catch {
      index = [];
    }
    return index;
  }

  const norm = (s: string) => s.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/[’']/g, "");

  function score(item: Item, terms: string[]) {
    const t = norm(item.title), x = norm(item.text);
    let s = 0;
    for (const term of terms) {
      if (t.includes(term)) s += t.startsWith(term) ? 6 : 4;
      else if (x.includes(term)) s += 1;
      else return 0;
    }
    return s;
  }

  function render(q: string) {
    list.replaceChildren();
    const terms = norm(q).split(/\s+/).filter(Boolean);
    hint.hidden = terms.length > 0;
    if (!terms.length || !index) return;
    const hits = index.map((i) => ({ i, s: score(i, terms) })).filter((h) => h.s > 0).sort((a, b) => b.s - a.s).slice(0, 12);
    if (!hits.length) {
      const li = document.createElement("li");
      li.className = "muted";
      li.style.padding = "12px";
      li.textContent = `Nothing matches “${q}”. Try a broader word, or browse the glossary.`;
      list.append(li);
      return;
    }
    for (const { i } of hits) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = page(i.url);
      a.innerHTML = `<div class="kind"></div><div class="t"></div><div class="s"></div>`;
      (a.children[0] as HTMLElement).textContent = i.kind;
      (a.children[1] as HTMLElement).textContent = i.title;
      (a.children[2] as HTMLElement).textContent = i.text.length > 140 ? i.text.slice(0, 140) + "…" : i.text;
      li.append(a);
      list.append(li);
    }
  }

  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    await ensureIndex();
    render(input.value);
  }

  document.querySelectorAll("[data-open-search]").forEach((b) => b.addEventListener("click", open));
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    const typing = t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable);
    if ((e.key === "/" && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) {
      e.preventDefault();
      open();
    }
  });
  input.addEventListener("input", () => render(input.value));
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
</script>
