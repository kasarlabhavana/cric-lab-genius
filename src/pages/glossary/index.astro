---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const terms = (await getCollection("glossary")).sort((a, b) => a.data.term.localeCompare(b.data.term));
const groups = new Map<string, typeof terms>();
for (const t of terms) {
  const k = t.data.term[0].toUpperCase();
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(t);
}
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "CricScience glossary",
  url: "https://cricscience.com/glossary",
  hasDefinedTerm: terms.map((t) => ({ "@type": "DefinedTerm", name: t.data.term, description: t.data.definition, url: `https://cricscience.com/glossary/${t.id}` })),
};
---
<Base title="Glossary" description={`${terms.length} cricket science terms, from boundary layer to umpire's call, each defined in plain English and linked to a lesson.`} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="head">
      <h1>Glossary</h1>
      <p class="lede">{terms.length} terms in plain English. Each links to the lesson that explains it properly.</p>
    </header>
    <nav class="jump" aria-label="Jump to letter">
      {[...groups.keys()].map((k) => <a href={`#${k}`}>{k}</a>)}
    </nav>
    {[...groups.entries()].map(([k, list]) => (
      <section class="group" id={k} aria-label={k}>
        <h2>{k}</h2>
        <dl>
          {list.map((t) => (
            <div class="entry">
              <dt><a href={`/glossary/${t.id}`}>{t.data.term}</a></dt>
              <dd>{t.data.definition}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
<style>
  .head { padding: 40px 0 24px; max-width: 46rem; }
  .head .lede { margin-top: 16px; }
  .jump { display: flex; flex-wrap: wrap; gap: 4px; position: sticky; top: 60px; background: var(--bg); padding: 10px 0; border-bottom: 1px solid var(--rule); z-index: 5; }
  .jump a { min-width: 34px; text-align: center; padding: 6px 4px; text-decoration: none; font-weight: 700; color: var(--ink-2); border-radius: 4px; }
  .jump a:hover { background: var(--outfield-soft); color: var(--ink); }
  .group { display: grid; grid-template-columns: 1fr; gap: 8px; padding: 28px 0; border-bottom: 1px solid var(--rule); scroll-margin-top: 120px; }
  @media (min-width: 760px) { .group { grid-template-columns: 80px 1fr; } }
  .group h2 { font-size: var(--s4); color: var(--outfield); }
  dl { margin: 0; display: grid; gap: 18px; max-width: 46rem; }
  dt a { font-weight: 700; font-size: var(--s1); color: var(--ink); text-decoration: none; }
  dt a:hover { text-decoration: underline; }
  dd { margin: 4px 0 0; font-family: var(--serif); color: var(--ink-2); }
</style>
