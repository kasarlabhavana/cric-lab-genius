---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist on CricScience.">
  <div class="wrap nf">
    <h1>Not out, but not here</h1>
    <p class="lede">That page doesn't exist. It may have moved when the site was rebuilt.</p>
    <p><a class="btn btn-primary" href="/explore">Browse all lessons</a> <a class="btn btn-quiet" href="/">Go to the home page</a></p>
  </div>
</Base>
<style>
  .nf { padding: 64px var(--gutter) 0; }
  .lede { margin: 16px 0 28px; }
  .nf p:last-child { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
