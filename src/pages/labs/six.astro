---
import Base from "../../layouts/Base.astro";
import SixLab from "../../components/SixLab.astro";
---
<Base title="Six-hitting lab" description="Choose exit speed and launch angle and see how far a hit ball carries with air drag, compared with a world without air.">
  <div class="wrap lab">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/labs">Labs</a></nav>
    <h1>Six-hitting lab</h1>
    <p class="lede">Why 45° is the wrong answer, and why bat speed matters more than angle.</p>
    <div class="stage"><SixLab /></div>
    <section class="related">
      <h2>Read the science</h2>
      <ul><li><a href="/explore/bat-and-ball/hitting-a-six">The physics of a six</a></li><li><a href="/explore/bat-and-ball/the-sweet-spot">The sweet spot</a></li></ul>
    </section>
  </div>
</Base>
<style>
  .lab { padding-top: 28px; }
  .crumbs { font-size: var(--s-1); } .crumbs a { color: var(--ink-2); text-decoration: none; }
  h1 { margin-top: 24px; }
  .lede { margin: 14px 0 32px; }
  .stage { border-top: 2px solid var(--ink); padding-top: 28px; }
  .related { margin-top: 56px; }
  .related h2 { font-size: var(--s2); margin-bottom: 12px; }
  .related ul { padding-left: 1.2em; font-family: var(--serif); font-size: var(--s1); display: grid; gap: 6px; }
</style>
