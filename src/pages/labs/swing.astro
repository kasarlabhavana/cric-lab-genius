---
import Base from "../../layouts/Base.astro";
import SwingLab from "../../components/SwingLab.astro";
---
<Base title="Swing lab" description="See how ball condition, speed and seam angle decide between conventional swing, reverse swing and no swing, using the boundary-layer picture.">
  <div class="wrap lab">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/labs">Labs</a></nav>
    <h1>Swing lab</h1>
    <p class="lede">Viewed from above with the ball travelling up the screen and the seam angled to the right. Change the ball's condition, its speed and the seam angle.</p>
    <div class="stage"><SwingLab /></div>
    <section class="related">
      <h2>Read the science</h2>
      <ul><li><a href="/explore/ball-in-flight/conventional-swing">Why a new ball swings</a></li><li><a href="/explore/ball-in-flight/reverse-swing">Why an old ball swings the other way</a></li><li><a href="/explore/ball-in-flight/do-clouds-help-swing">Do clouds and humidity really help swing?</a></li></ul>
    </section>
  </div>
</Base>
<style>
  .lab { padding-top: 28px; }
  .crumbs { font-size: var(--s-1); } .crumbs a { color: var(--ink-2); text-decoration: none; }
  h1 { margin-top: 24px; }
  .lede { margin: 14px 0 32px; }
  .stage { border-top: 2px solid var(--ink); padding-top: 28px; }
  .related { margin-top: 56px; }
  .related h2 { font-size: var(--s2); margin-bottom: 12px; }
  .related ul { padding-left: 1.2em; font-family: var(--serif); font-size: var(--s1); display: grid; gap: 6px; }
</style>
