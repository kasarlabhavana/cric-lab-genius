---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Quiz from "../../../components/Quiz.astro";
import { MODULES, MODULE_BY_SLUG } from "../../../data/modules";
import { lessonsByModule, lessonSlug, lessonUrl, LABS } from "../../../lib/content";

export async function getStaticPaths() {
  const map = await lessonsByModule();
  return MODULES.flatMap((m) => {
    const list = map.get(m.slug)!;
    return list.map((l, i) => ({
      params: { module: m.slug, lesson: lessonSlug(l) },
      props: { lesson: l, prev: list[i - 1] ?? null, next: list[i + 1] ?? null, index: i, total: list.length },
    }));
  });
}

const { lesson, prev, next, index, total } = Astro.props;
const mod = MODULE_BY_SLUG[lesson.data.module];
const { Content } = await render(lesson);
const lab = lesson.data.lab ? LABS.find((l) => l.slug === lesson.data.lab) : null;
const reviewed = lesson.data.lastReviewed.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const url = `https://cricscience.com${lessonUrl(lesson)}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: lesson.data.title,
    description: lesson.data.summary,
    url,
    inLanguage: "en-GB",
    learningResourceType: "Lesson",
    timeRequired: `PT${lesson.data.minutes}M`,
    dateModified: lesson.data.lastReviewed.toISOString().slice(0, 10),
    isPartOf: { "@type": "Course", name: mod.title, url: `https://cricscience.com/explore/${mod.slug}` },
    citation: lesson.data.sources.map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })),
    publisher: { "@type": "Organization", name: "CricScience", url: "https://cricscience.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Learn", item: "https://cricscience.com/explore" },
      { "@type": "ListItem", position: 2, name: mod.title, item: `https://cricscience.com/explore/${mod.slug}` },
      { "@type": "ListItem", position: 3, name: lesson.data.title, item: url },
    ],
  },
];
---
<Base title={lesson.data.title} description={lesson.data.summary} jsonLd={jsonLd} ogType="article">
  <article class="wrap lesson">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/explore">Learn</a><span aria-hidden="true">/</span><a href={`/explore/${mod.slug}`}>{mod.title}</a>
    </nav>
    <header class="lesson-head">
      <p class="pos muted num">Lesson {index + 1} of {total}</p>
      <h1>{lesson.data.title}</h1>
      <p class="lede">{lesson.data.summary}</p>
      <p class="meta muted"><span class="num">{lesson.data.minutes} min read</span><span>Last reviewed {reviewed}</span></p>
      <p class="done-flag" data-done-flag data-lesson={lesson.id} hidden>You've completed this lesson.</p>
    </header>

    <div class="layout">
      <aside class="rail" aria-label="Evidence">
        {lesson.data.established.length > 0 && (
          <section class="ev ev-est">
            <h2>Established</h2>
            <ul>{lesson.data.established.map((e) => <li>{e}</li>)}</ul>
          </section>
        )}
        {lesson.data.debated.length > 0 && (
          <section class="ev ev-deb">
            <h2>Still debated</h2>
            <ul>{lesson.data.debated.map((e) => <li>{e}</li>)}</ul>
          </section>
        )}
        {lab && (
          <a class="lab-link" href={`/labs/${lab.slug}`}>
            <span class="lab-k">Try it in the lab</span>
            <span class="lab-t">{lab.title}</span>
            <span class="lab-l">{lab.line}</span>
          </a>
        )}
      </aside>

      <div class="body">
        <div class="prose"><Content /></div>

        <section class="sources" aria-labelledby="src-title">
          <h2 id="src-title">Sources</h2>
          <ol>
            {lesson.data.sources.map((s) => (
              <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>
            ))}
          </ol>
          <p class="muted small">Spotted an error? Email <a href={`mailto:hello@cricscience.com?subject=${encodeURIComponent("Correction: " + lesson.data.title)}`}>hello@cricscience.com</a> with the source and we'll review it.</p>
        </section>

        <Quiz lessonId={lesson.id} questions={lesson.data.quiz} />

        <nav class="pager" aria-label="Lessons in this science">
          {prev ? <a class="btn btn-quiet" href={lessonUrl(prev)}><span class="dir">Previous</span>{prev.data.title}</a> : <span />}
          {next
            ? <a class="btn btn-primary" href={lessonUrl(next)}><span class="dir">Next</span>{next.data.title}</a>
            : <a class="btn btn-primary" href={`/explore/${mod.slug}`}><span class="dir">Finished</span>Back to {mod.title}</a>}
        </nav>
      </div>
    </div>
  </article>
</Base>

<style>
  .lesson { padding-top: 28px; }
  .crumbs { display: flex; gap: 8px; font-size: var(--s-1); color: var(--ink-3); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .lesson-head { margin: 28px 0 40px; max-width: 52rem; }
  .pos { margin: 0 0 10px; font-size: var(--s-1); }
  .lesson-head h1 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .lede { margin: 18px 0 0; }
  .meta { margin: 18px 0 0; font-size: var(--s-1); display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .done-flag { margin: 12px 0 0; color: var(--good); font-weight: 650; font-size: var(--s-1); }
  .layout { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: minmax(0, 1fr) 280px; gap: 64px; }
    .rail { order: 2; position: sticky; top: 84px; align-self: start; }
  }
  .rail { display: grid; gap: 20px; align-content: start; }
  .ev { border-left: 3px solid var(--outfield); padding: 2px 0 2px 16px; }
  .ev-deb { border-left-color: var(--clay); }
  .ev h2 { font-size: var(--s0); font-weight: 750; font-variation-settings: "wdth" 110; margin-bottom: 8px; }
  .ev ul { margin: 0; padding-left: 1.1em; font-size: 0.95rem; color: var(--ink-2); display: grid; gap: 8px; }
  .lab-link { display: grid; gap: 4px; padding: 16px; background: var(--clay-soft); border-radius: 8px; text-decoration: none; color: var(--ink); }
  .lab-link:hover { outline: 2px solid var(--clay); }
  .lab-k { font-size: var(--s-1); color: var(--ink-2); }
  .lab-t { font-weight: 750; font-variation-settings: "wdth" 112; font-size: var(--s1); }
  .lab-l { font-family: var(--serif); font-size: 0.95rem; color: var(--ink-2); }
  .sources { margin-top: 48px; max-width: var(--read); }
  .sources h2 { font-size: var(--s2); margin-bottom: 12px; }
  .sources ol { padding-left: 1.4em; display: grid; gap: 8px; font-size: 0.95rem; }
  .small { font-size: var(--s-1); }
  .pager { display: flex; justify-content: space-between; gap: 12px; margin-top: 56px; max-width: var(--read); flex-wrap: wrap; }
  .pager .btn { flex-direction: column; align-items: flex-start; gap: 2px; max-width: 100%; }
  .pager .dir { font-size: 0.78rem; font-weight: 500; opacity: 0.85; }
</style>

<script>
  import { load } from "../../../scripts/store";
  const flag = document.querySelector<HTMLElement>("[data-done-flag]");
  const show = () => { if (flag && load().lessons[flag.dataset.lesson!]) flag.hidden = false; };
  show();
  window.addEventListener("cs:progress", show);
</script>
